[Unit]
Description=Antigravity ACP Bridge (YHDev Bekerja dengan Hati @ 2026)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/antigravity-acp-bridge
ExecStart=/usr/bin/python3 %h/antigravity-acp-bridge/antigravity_acp_bridge.py --port 8877 --host 127.0.0.1 --max-concurrency 2 --worker-idle-timeout 120
Restart=on-failure
RestartSec=5
Environment=HOME=%h
Environment=PATH=%h/.local/bin:%h/.antigravity/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
